# URL pública. Em desenvolvimento, use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fonte dos dados empresariais: auto | demo | live
# auto = Google Places quando a chave existir; demonstração quando não existir.
LEADFLOW_DATA_MODE=auto

# Adicione somente no lançamento. Nunca use o prefixo NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Controles de custo e volume por missão.
GOOGLE_PLACES_MAX_RESULTS=8
GOOGLE_PLACES_ENRICH_LIMIT=8

# Supabase Auth + banco. Use a Publishable Key atual ou a Anon Key legada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reservada para rotinas administrativas futuras. Não é usada no navegador.
SUPABASE_SERVICE_ROLE_KEY=
